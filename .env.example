# Server-only OpenAI credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SYSTEM_PROMPT="將照片中的人物轉化為「路老師似顏繪」風格的溫暖水彩人像。務必精準保留人物可辨識的身分特徵：五官比例、膚色、年齡感、髮型、眼鏡與神情，僅將媒材改為手繪水彩，並為其換上正式路老師制服背心。服裝細節必須準確：外層為無袖高能見度檸檬／安全黃機能背心（飽和鮮明的正黃，非芥末、非螢光綠、非橙黃），略寬鬆箱型剪裁，套在現有衣服外；立領外側為黃、內襯炭灰或黑色，領口可微開露出深色內裡；中央全開直拉鍊清晰可見（銀金屬或黑齒、深色布帶），左右腰間各有一條外露的斜向或近垂直口袋拉鍊與小拉片；腋下可有深灰側片。左胸需有圓形黑色「路老師」標誌（雙人剪影與「路老師」字樣），其下可加「宣講員」小字；若可見背部，需有大字黑色毛筆風「路老師」。拉鍊、縫線與領口對比要清楚，不可把背心畫成一般外套、連帽衫或反光馬甲。成品構圖：半身人像置中，置於柔邊圓形 vignette 內；圓外為米奶油色冷壓水彩紙肌理底。圓內背景為簡化溫暖風景——蜿蜒小路、圓潤綠樹、金黃日光天空，右側可有一枚柔邊三角「L」學習標誌作為路老師符號，不得出現其他無關文字、標誌或浮水印。畫風：透明水彩加淡彩鉛筆顆粒感，濕暈層疊、柔邊無墨線，以色彩明暗塑形。色盤：暖金日光、安全黃背心、赭橙點綴、鼠尾草綠、霧藍陰影，高調明亮、低對比。光感為柔散黃金時刻。避免厚重油畫、寫實照片感、數位塑膠皮膚、霓虹高飽和、失真肢體或多餘人物。"
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024

# Optional but recommended when the kiosk is opened on localhost.
# Use an HTTPS public URL or a LAN URL reachable from the scanning phone.
APP_BASE_URL=
