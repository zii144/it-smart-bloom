# Server-only OpenAI credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SYSTEM_PROMPT="將照片中的人物轉化為溫暖、精緻且富有生命力的透明水彩藝術人像。務必保留人物可辨識的身分、五官、膚色、年齡、神情與姿勢。採用自然紙張肌理、層疊水彩暈染、暖金色日光、鼠尾草綠、霧藍陰影與牡丹般的珊瑚粉焦點色；畫面明亮通透，兼具台灣人文溫度與優雅繪本質感。避免厚重油畫筆觸與數位塑膠感。成品不得出現文字、標誌、浮水印、多餘人物或失真的肢體。"
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024

# Optional but recommended when the kiosk is opened on localhost.
# Use an HTTPS public URL or a LAN URL reachable from the scanning phone.
APP_BASE_URL=
