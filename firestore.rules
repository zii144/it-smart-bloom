rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSeatDisplay() {
      return request.auth != null
        && request.auth.token.seatStatusDisplay == true
        && request.time.toMillis() < request.auth.token.seatStatusExpiresAt;
    }
    // This collection contains only seat labels and arrival timestamps.
    match /seatStatus/{id} {
      allow read: if isSeatDisplay();
      allow write: if false;
    }
    match /seatStatusMeta/checkIn {
      allow read: if isSeatDisplay();
      allow write: if false;
    }
    // Private roster, portrait and identity documents stay server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
