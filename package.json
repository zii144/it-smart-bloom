{
  "name": "zhisheng-bloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/free-dev-ports.cjs && firebase emulators:exec --project it-smart-bloom-tmp --only firestore,storage --ui \"next dev --port 3059\"",
    "dev:next": "next dev --port 3059",
    "emulators": "firebase emulators:start --project it-smart-bloom-tmp --only firestore,storage",
    "build": "next build",
    "start": "next start --port 3059",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "firebase emulators:exec --config firebase.emulator-test.json --project it-smart-bloom-tmp --only firestore,storage \"vitest run .emulator.test --no-file-parallelism\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "firebase": "13.1.0",
    "firebase-admin": "^14.2.0",
    "next": "16.4.2",
    "openai": "^6.49.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "9.3.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "firebase-tools": "^15.24.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
